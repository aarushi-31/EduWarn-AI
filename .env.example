# Environment Configuration for AI Student Performance Prediction System
# Copy this file to .env for local overrides (never commit .env to GitHub)

FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-key-in-production-min32chars!
DATABASE_URI=sqlite:///instance/student_performance.db
ML_MODEL_PATH=ml/models/best_student_model.joblib
